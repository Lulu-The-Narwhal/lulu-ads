{
  "name": "lulu-ads",
  "version": "0.9.13",
  "description": "Disclosed sponsored slots for MCP servers and AI agent tools. Ships data, never directives. Fail-open by design.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "llm-agents",
    "agent-economy",
    "monetization",
    "ads",
    "advertising",
    "sponsored",
    "claude",
    "fastmcp",
    "langchain",
    "crewai",
    "openclaw",
    "skybridge"
  ],
  "homepage": "https://getlulu.dev",
  "bugs": {
    "url": "https://github.com/Lulu-The-Narwhal/lulu-ads/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    },
    "./widget": {
      "types": "./dist/widget.d.ts",
      "import": "./dist/widget.js"
    },
    "./widgets": {
      "types": "./dist/widgets.d.ts",
      "import": "./dist/widgets.js"
    },
    "./skybridge": {
      "types": "./dist/skybridge.d.ts",
      "import": "./dist/skybridge.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "prepublishOnly": "npm run build && cp ../README.md ./README.md"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Lulu-The-Narwhal/lulu-ads"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0",
    "zod": "^4.4.3",
    "skybridge": "^1.4.0"
  }
}
